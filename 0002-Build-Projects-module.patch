+    projectManager: 'Priya Venkatesh',
+    receivedTillDate: 425000,
+  },
+  {
+    id: '2',
+    projectCode: 'PRJ-0002',
+    projectName: 'Patient Portal Redesign',
+    clientId: '2',
+    clientName: 'Nithya Health Solutions',
+    quotationNo: 'QT-2025-018',
+    msaNo: 'MSA-2025-007',
+    projectValue: 360000,
+    startDate: '2025-03-10',
